# mock: API 키 없이 규칙 기반으로 동작 / openai: 실제 AI 사용
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
# 배포: Neon 접속 주소(postgresql://...?sslmode=require)를 그대로 넣으면 됩니다.
DATABASE_URL=sqlite:///./changewatch.db
# 여러 개는 쉼표로 구분 (배포: Vercel 주소 추가)
CORS_ORIGINS=http://localhost:5173
# 선택: 매번 바뀌는 Vercel 미리보기 주소 허용용 정규식
CORS_ORIGIN_REGEX=
